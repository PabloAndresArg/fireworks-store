# Copia este archivo como supabase/functions/.env y súbelo con:
#   supabase secrets set --env-file supabase/functions/.env
# Los secretos SMTP ya existen en el proyecto si la versión anterior de la función enviaba correos.

# Cuenta de Gmail que envía los correos y su contraseña de aplicación
# (https://myaccount.google.com/apppasswords; no es la contraseña normal de la cuenta).
SMTP_USER=
SMTP_PASS=

# Opcionales: servidor y puerto SMTP (por defecto smtp.gmail.com y 465).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Quién recibe las órdenes internas; varios correos separados por coma (obligatorio).
ORDER_EMAIL_TO=

# Dominios del frontend permitidos (CORS), separados por coma. "*" permite cualquiera.
ALLOWED_ORIGINS=https://cuetesya.store,http://localhost:5173
