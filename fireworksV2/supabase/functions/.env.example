# Copia este archivo como supabase/functions/.env y súbelo con:
#   supabase secrets set --env-file supabase/functions/.env

# Clave de la API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Quién recibe las órdenes; varios correos separados por coma
ORDER_EMAIL_TO=

# Remitente con dominio verificado en Resend. Sin dominio propio, onboarding@resend.dev
# solo puede enviar al correo de la cuenta de Resend.
ORDER_EMAIL_FROM=CuetesYa <onboarding@resend.dev>

# Dominios del frontend permitidos (CORS), separados por coma. "*" permite cualquiera.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
